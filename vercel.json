{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/aicte-directory",
      "destination": "https://indian-colleges-list.vercel.app/api/institutions?online=1&allStates=1&year=2026-2027&program=1&level=1&institutiontype=1&Women=1&Minority=1&course=1"
    }
  ],
  "headers": [
    {
      "source": "/api/aicte-directory",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "aicte-engineering-directory"
        }
      ]
    }
  ]
}
